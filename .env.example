# Backend (FastAPI) — copy to backend/.env, never commit real keys
SUPABASE_URL=https://gjjlqqwmvmlesbkgyefm.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upper (cloud) AI — only ever receives public project data
# Leave UPPER_PROVIDER empty to auto-pick from the key you fill in (gemini, groq or router)
UPPER_PROVIDER=gemini
GEMINI_API_KEY=
# Exact model id (e.g. gemini-2.5-flash). If it is wrong, the backend picks the closest model your key can use.
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
ROUTER_BASE_URL=
ROUTER_API_KEY=
ROUTER_MODEL=

# Inner (local) AI — private project chat, may see the confidential brief
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

HIDDEN_TEST_DIR=seed/hidden_tests
